# Entorno local. Copia a .env y ajusta.
# NUNCA subir .env a git. En produccion usar el secret manager del hosting.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ticketflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/ticketflow

# Secreto para firmar JWT. Genera uno propio: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=super-secreto-cambia-esto
JWT_EXPIRES_MINUTES=480

# CORS: origenes permitidos (react dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# En que host/port escucha la API
API_HOST=0.0.0.0
API_PORT=8000