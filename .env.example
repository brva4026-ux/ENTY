# Entorno local. Copia a .env y ajusta.
# NUNCA subir .env a git. En produccion usar el secret manager del hosting.
# Esta lista refleja app/core/config.py: si una variable existe alli, esta aca.
# Las que arrancan vacias son OPCIONALES: vacio = funcion deshabilitada (no-op),
# nunca un error. Solo JWT_SECRET es obligatorio en produccion.

# --- Base de datos --------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ticketflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/ticketflow

# --- App / API ------------------------------------------------------------
APP_NAME=Enty API
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
# Prefijo externo cuando la API va detras de un rewrite (Vercel: /api).
API_ROOT_PATH=

# --- Auth -----------------------------------------------------------------
# Secreto para firmar JWT. Genera uno propio: python -c "import secrets; print(secrets.token_hex(32))"
# OBLIGATORIO en produccion (minimo 32 caracteres; la app no arranca sin el).
JWT_SECRET=super-secreto-cambia-esto
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# CORS: origenes permitidos (react dev server). En ENVIRONMENT=production los
# hosts locales se descartan solos: la UI es same-origin (/api), asi que CORS
# no hace falta; un origen local permitido en prod es un agujero invisible.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Datos demo -----------------------------------------------------------
# El endpoint /seed SOLO funciona con IS_DEMO=true explicito. En produccion
# dejar en false: habilita la siembra de datos de demostracion.
IS_DEMO=false

# --- URL publica (links de reset/invitacion y share) ----------------------
APP_PUBLIC_URL=https://ticketflow-brva4026-uxs-projects.vercel.app

# --- Email transaccional (Resend) -----------------------------------------
# Vacio = email deshabilitado: reset self-service e invitaciones no envian
# correo (el flujo guia al reset operado por admin). Requiere APP_PUBLIC_URL.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Enty <onboarding@resend.dev>

# --- Web Push (VAPID) -----------------------------------------------------
# Vacio = push deshabilitado. Genera las claves con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY_B64=
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:admin@ticketflow.app

# --- Pagos online (Wompi) -------------------------------------------------
# Vacio = pagos deshabilitados (la API responde 503 al crear cobros y el
# webhook rechaza: sin secreto no hay firma que validar).
# wompi_env: test -> sandbox.wompi.co (claves prv_test_); prod -> produccion.
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=test

# --- Observabilidad (Sentry) ----------------------------------------------
# Vacio = no-op silencioso: los errores 500 NO se reportan a nadie. En
# produccion conviene definirla: es lo que hace visible un 500 en /health
# (error_tracking: true) y en el panel de Sentry.
SENTRY_DSN=
